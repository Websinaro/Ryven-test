# ---------------------------------------------------------
# Video/image URLs are NOT set here anymore.
# Paste all Cloudinary links directly into:
#   src/config/media-links.ts
# ---------------------------------------------------------

# Contact / social links shown in the footer + CTA section
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/yourstudio
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567
NEXT_PUBLIC_CONTACT_EMAIL=hello@ryvencreatives.com

# Used by the optional /upload page (unsigned upload — safe to expose,
# no API secret involved). Upload a file there, then copy the returned
# URL into src/config/media-links.ts.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset
